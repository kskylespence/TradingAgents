# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: Bearer token for Ollama Cloud. A local ollama-serve needs no
# auth, so this is unset by default. For Ollama Cloud, set both this and
# OLLAMA_BASE_URL=https://ollama.com/v1.
#OLLAMA_API_KEY=

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Lite VPS preset (2 vCPU / 8 GB, cloud LLM only — see web/docs/operations.md)
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_RUN_MAX_SECONDS=1200
#TRADINGAGENTS_LLM_READ_TIMEOUT=90
#TRADINGAGENTS_LLM_MAX_RETRIES=3
# Do NOT set OLLAMA_BASE_URL unless Ollama runs on a remote host or Ollama Cloud.

# Optional: LLM resilience tuning. The OpenAI-compatible chat client
# applies these defaults to every cloud provider (ollama, openrouter,
# xai, deepseek, qwen*, glm*, minimax*); native openai keeps its own
# tighter defaults. See web/docs/operations.md.
#
# Number of retries on transient 5xx / connection errors. Default 5
# for cloud providers, 2 for native openai. Increase if your provider
# blips run longer than ~30s; decrease to fail fast.
#TRADINGAGENTS_LLM_MAX_RETRIES=5
#
# Read-timeout in seconds for chat completions. Default 120.
# Replaces only the read field of httpx.Timeout(connect=10, read=120,
# write=10, pool=10). Bounded so a hung upstream releases the
# single-run lock instead of pinning the app for httpx's 10-min default.
#TRADINGAGENTS_LLM_READ_TIMEOUT=120
