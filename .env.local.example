# TradingAgents — local development environment template.
#
# Copy to .env.local and replace EVERY placeholder. The placeholders in
# this template are intentionally short so the backend's pydantic-settings
# validator refuses to start (with a ValidationError that names the
# unreplaced field) if you forget to substitute one — there is no silent
# default fallback for any of these secrets.
#
#   cp .env.local.example .env.local
#
# The .env.local file is git-ignored. Production secrets live in Coolify's
# project settings (marked "runtime only"), never on disk.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Operator account credentials. ADMIN_PASSWORD_HASH is a bcrypt hash; generate
# it on your workstation rather than putting the plaintext anywhere.
#
#   python -c "from passlib.hash import bcrypt; print(bcrypt.using(rounds=12).hash('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_ME_BCRYPT_HASH

# JWT signing key for the login cookie. Rotate to invalidate every session.
#
#   openssl rand -hex 32
JWT_SECRET=REPLACE_ME_JWT_SECRET_DEV_ONLY
JWT_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# Fernet symmetric key used to encrypt provider API keys at rest in Postgres.
# 32 url-safe base64 bytes. Losing this key means stored API keys are unreadable.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_ME_FERNET_KEY_DEV_ONLY

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# When running under docker compose this is overridden by the compose file to
# point at the `db` service. Set a Neon URL here only when running the backend
# directly against Neon from your workstation.
#
# Neon URLs MUST include ?ssl=require for asyncpg.
DATABASE_URL=postgresql+asyncpg://tradingagents:devpassword@localhost:5432/tradingagents

# ---------------------------------------------------------------------------
# Disk / retention
# ---------------------------------------------------------------------------
DATA_DIR=/data/tradingagents
RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Coolify-injected magic vars (left blank locally; populated in production)
# ---------------------------------------------------------------------------
COOLIFY_FQDN=
COOLIFY_URL=

# ---------------------------------------------------------------------------
# Optional pre-seeded provider keys
# ---------------------------------------------------------------------------
# Uncomment and fill in to skip the in-app Settings step on first deploy.
# These override values stored in the encrypted api_keys table.
#
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_CN_API_KEY=
# MOONSHOT_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPUAI_API_KEY=
# ZHIPUAI_CN_API_KEY=
# MINIMAX_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
